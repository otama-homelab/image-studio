@@ -148,6 +148,23 @@ VulkanImage::VulkanImage(
     image_properties_.image_extents.depth = 1u;
   }
 
+  VkPhysicalDeviceProperties physical_properties{};
+  vkGetPhysicalDeviceProperties(
+      allocator_info.physicalDevice, &physical_properties);
+  const auto& limits = physical_properties.limits;
+  const auto& extent = image_properties_.image_extents;
+  const auto image_type = image_properties_.image_type;
+  const uint32_t dimension_limit = image_type == VK_IMAGE_TYPE_3D
+      ? limits.maxImageDimension3D
+      : (image_type == VK_IMAGE_TYPE_2D ? limits.maxImageDimension2D
+                                      : limits.maxImageDimension1D);
+  VK_CHECK_COND(
+      extent.width <= dimension_limit && extent.height <= dimension_limit &&
+          extent.depth <= dimension_limit,
+      "Vulkan image extent exceeds physical device dimension limit: ",
+      extent.width, "x", extent.height, "x", extent.depth,
+      " limit=", dimension_limit, " imageType=", image_type);
+
   const VkImageCreateInfo image_create_info{
       VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO, // sType
