+// GELU approximate="none": evaluate the erf form rather than the tanh form.
+// The polynomial approximates erf to float32 accuracy; validated separately
+// against torch.nn.functional.gelu across the inference input range.
+float gelu_erf(float x) {
+  const float z = x * 0.7071067811865475;
+  const float t = 1.0 / (1.0 + 0.3275911 * abs(z));
+  const float poly = (((((1.061405429 * t - 1.453152027) * t)
+      + 1.421413741) * t - 0.284496736) * t + 0.254829592) * t;
+  const float erf_value = sign(z) * (1.0 - poly * exp(-z * z));
+  return 0.5 * x * (1.0 + erf_value);
+}
+
+vec4 gelu_erf(vec4 x) {
+  return vec4(gelu_erf(x.x), gelu_erf(x.y), gelu_erf(x.z), gelu_erf(x.w));
+}
