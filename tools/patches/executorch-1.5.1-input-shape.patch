+Result<executorch::extension::BufferCleanup> prepare_model_inputs(
+    Method& method,
+    const std::vector<std::pair<char*, size_t>>& buffers) {
+  if (FLAGS_input_shape.empty()) {
+    return executorch::extension::prepare_input_tensors(method, {}, buffers);
+  }
+  if (buffers.size() != 1 || method.method_meta().num_inputs() != 1) {
+    return Error::InvalidArgument;
+  }
+  using executorch::aten::TensorImpl;
+  std::vector<TensorImpl::SizesType> sizes;
+  std::istringstream stream(FLAGS_input_shape);
+  std::string token;
+  try {
+    while (std::getline(stream, token, ',')) {
+      size_t used = 0;
+      const long size = std::stol(token, &used);
+      if (used != token.size() || size < 1 || size > 2048) {
+        return Error::InvalidArgument;
+      }
+      sizes.push_back(static_cast<TensorImpl::SizesType>(size));
+    }
+  } catch (const std::exception&) {
+    return Error::InvalidArgument;
+  }
+  if (sizes.size() != 4 || sizes[0] != 1 || sizes[1] > 4) {
+    return Error::InvalidArgument;
+  }
+  size_t count = 1;
+  for (const auto size : sizes) {
+    count *= static_cast<size_t>(size);
+  }
+  if (buffers[0].second != count * sizeof(float)) {
+    return Error::InvalidArgument;
+  }
+  TensorImpl::DimOrderType order[] = {0, 1, 2, 3};
+  TensorImpl impl(ScalarType::Float, 4, sizes.data(), buffers[0].first, order);
+  Tensor tensor(&impl);
+  const Error result = method.set_input(tensor, 0);
+  if (result != Error::Ok) {
+    return result;
+  }
+  // buffers own the input data; Method copies shape metadata during set_input.
+  return executorch::extension::BufferCleanup(Span<void*>(static_cast<void**>(nullptr), size_t(0)));
+}
