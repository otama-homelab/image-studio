diff --git a/backends/vulkan/runtime/graph/ops/impl/Clone.cpp b/backends/vulkan/runtime/graph/ops/impl/Clone.cpp
index df075c6..48ba066 100644
--- a/backends/vulkan/runtime/graph/ops/impl/Clone.cpp
+++ b/backends/vulkan/runtime/graph/ops/impl/Clone.cpp
@@ -27,11 +27,23 @@ void resize_clone_node(
   (void)resize_args;
   const ValueRef out = args.at(0).refs.at(0);
   const ValueRef in = args.at(1).refs.at(0);
-  // TODO: support for when dimensionality doesn't match, i.e. clone is used to
-  // implement squeeze.
-  if (graph->dim_of(out) == graph->dim_of(in)) {
-    graph->virtual_resize(out, graph->sizes_of(in));
+  std::vector<int64_t> sizes = graph->sizes_of(in);
+  const auto out_dim = graph->dim_of(out);
+  if (out_dim == sizes.size()) {
+    graph->virtual_resize(out, sizes);
+  } else if (out_dim < sizes.size()) {
+    // Texture squeeze of leading singleton dimensions uses the clone shader.
+    // Its logical extent is unchanged, but the output shape must still follow
+    // changes in the remaining input dimensions.
+    const size_t removed = sizes.size() - out_dim;
+    for (size_t i = 0; i < removed; ++i) {
+      VK_CHECK_COND(sizes.at(i) == 1,
+                    "Clone can only remove leading singleton dimensions");
+    }
+    sizes.erase(sizes.begin(), sizes.begin() + removed);
+    graph->virtual_resize(out, sizes);
   }
+
 }
 
